{
  "version": "0.2.0",
  "configurations": [
    {
      "type": "node",
      "request": "launch",
      "name": "Debug TurnosRed (tsx)",
      "runtimeExecutable": "${workspaceFolder}/node_modules/.bin/tsx.cmd",
      "runtimeArgs": ["watch", "src/index.ts"],
      "skipFiles": ["<node_internals>/**"],
      "console": "integratedTerminal",
      "envFile": "${workspaceFolder}/.env",
      "cwd": "${workspaceFolder}"
    }
  ]
}
